<Window x:Class="BiliIndexTranslate.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BiliIndexTranslate.App.Localization"
        Title="{loc:Tr Settings_Title}"
        Style="{StaticResource UiWindow}"
        Width="480" SizeToContent="Height" MaxHeight="860"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
  <Window.Resources>
    <Style TargetType="TextBox" BasedOn="{StaticResource UiTextBox}" />
    <Style TargetType="PasswordBox" BasedOn="{StaticResource UiPasswordBox}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource UiCheckBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource UiComboBox}" />
  </Window.Resources>
  <DockPanel>
    <!-- Action bar -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,1,0,0" Padding="18,10" Background="{DynamicResource Ui.Panel}">
      <DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="250" Foreground="{DynamicResource Ui.TextSecondary}" FontSize="12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="{loc:Tr Common_Cancel}" Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
          <Button x:Name="SaveButton" Style="{StaticResource SecondaryButton}" Content="{loc:Tr Common_Save}" Margin="0,0,8,0" Click="OnSave" />
          <Button x:Name="SaveTestButton" Style="{StaticResource PrimaryButton}" Content="{loc:Tr Settings_SaveAndTest}" Click="OnSaveAndTest" IsDefault="True" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,6,18,14">
      <StackPanel>
        <!-- Reading -->
        <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Tr Settings_GroupReading}" />
        <CheckBox x:Name="AutoTranslateBox" Content="{loc:Tr Settings_AutoTranslate}" />
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_TranslateInto}" />
          <ComboBox x:Name="TargetLanguageBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Margin="0,3" />
          <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_TextSize}" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
            <Slider x:Name="TextScaleSlider" Minimum="0.8" Maximum="1.6" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center" ValueChanged="OnTextScaleChanged" />
            <TextBlock x:Name="TextScaleLabel" Margin="10,0,0,0" VerticalAlignment="Center" Width="44" />
            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Common_Reset}" Padding="8,2" Click="OnResetTextScale" />
          </StackPanel>
          <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Appearance}" />
          <ComboBox x:Name="ThemeBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="0,3">
            <ComboBoxItem Content="{loc:Tr Settings_ThemeSystem}" />
            <ComboBoxItem Content="{loc:Tr Settings_ThemeLight}" />
            <ComboBoxItem Content="{loc:Tr Settings_ThemeDark}" />
          </ComboBox>
          <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_EditableFields}" />
          <ComboBox x:Name="EditablePolicyBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="0,3" MinWidth="260">
            <ComboBoxItem Content="{loc:Tr Settings_EditableSkipSingle}" />
            <ComboBoxItem Content="{loc:Tr Settings_EditableSkipAll}" />
            <ComboBoxItem Content="{loc:Tr Settings_EditableAll}" />
          </ComboBox>
          <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_UiLanguage}" />
          <ComboBox x:Name="UiLanguageBox" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Margin="0,3">
            <ComboBoxItem Content="{loc:Tr Settings_UiLanguageAuto}" />
            <ComboBoxItem Content="English" />
            <ComboBoxItem Content="简体中文" />
          </ComboBox>
        </Grid>
        <CheckBox x:Name="ShowOriginalBox" Content="{loc:Tr Settings_ShowOriginal}" />
        <TextBlock Style="{StaticResource HintText}" Text="{loc:Tr Settings_WheelHint}" />

        <!-- Service -->
        <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Tr Settings_GroupService}" />
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_ApiFormat}" />
          <ComboBox x:Name="ApiFormatBox" Grid.Column="1" HorizontalAlignment="Left" MinWidth="260" SelectionChanged="OnApiFormatChanged">
            <ComboBoxItem Content="{loc:Tr Settings_FormatOpenAi}" />
            <ComboBoxItem Content="{loc:Tr Settings_FormatDeeplx}" />
            <ComboBoxItem Content="{loc:Tr Settings_FormatCustom}" />
          </ComboBox>
        </Grid>
        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Endpoint}" Margin="0,0,0,3" />
        <TextBox x:Name="EndpointBox" />
        <TextBlock Style="{StaticResource HintText}" Text="{loc:Tr Settings_EndpointHelp}" />

        <!-- Custom JSON API template -->
        <StackPanel x:Name="CustomPanel" Visibility="Collapsed" Margin="0,8,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Preset}" />
            <ComboBox x:Name="CustomPresetBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" MinWidth="260" Margin="0,3" SelectionChanged="OnCustomPresetChanged" />
            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_DisplayName}" />
            <TextBox x:Name="CustomNameBox" Grid.Row="1" Grid.Column="1" Width="260" HorizontalAlignment="Left" Margin="0,3" />
            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Method}" />
            <ComboBox x:Name="CustomMethodBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" MinWidth="90" Margin="0,3">
              <ComboBoxItem Content="POST" />
              <ComboBoxItem Content="GET" />
            </ComboBox>
          </Grid>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Headers}" Margin="0,6,0,3" />
          <TextBox x:Name="CustomHeadersBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Height="44" FontFamily="Consolas" FontSize="12" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Body}" Margin="0,6,0,3" />
          <TextBox x:Name="CustomBodyBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Height="58" FontFamily="Consolas" FontSize="12" />
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_ResultPath}" />
            <TextBox x:Name="CustomResultPathBox" Grid.Row="0" Grid.Column="1" Margin="0,3" FontFamily="Consolas" FontSize="12" />
            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_ErrorPath}" />
            <TextBox x:Name="CustomErrorPathBox" Grid.Row="1" Grid.Column="1" Margin="0,3" FontFamily="Consolas" FontSize="12" />
          </Grid>
          <TextBlock Style="{StaticResource HintText}" Text="{loc:Tr Settings_PlaceholdersHelp}" />
        </StackPanel>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_ApiKey}" Margin="0,0,0,3" />
          <PasswordBox x:Name="ApiKeyBox" Grid.Row="1" Grid.Column="0" />
          <TextBox x:Name="ApiKeyPlainBox" Grid.Row="1" Grid.Column="0" Visibility="Collapsed" />
          <Button x:Name="RevealKeyButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{loc:Tr Settings_Show}" Margin="6,0,0,0" Padding="8,3" Click="OnRevealKey" />
        </Grid>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Model}" />
          <ComboBox x:Name="ModelBox" Grid.Column="1" IsEditable="True" HorizontalAlignment="Left" MinWidth="220" />
        </Grid>
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_VisionModel}" />
          <ComboBox x:Name="VisionModelBox" Grid.Column="1" IsEditable="True" HorizontalAlignment="Left" MinWidth="220" />
        </Grid>
        <TextBlock Style="{StaticResource HintText}" Text="{loc:Tr Settings_VisionHelp}" />
        <CheckBox x:Name="RelayBox" Content="{loc:Tr Settings_UseRelay}" Margin="0,8,0,2" Checked="OnRelayToggled" Unchecked="OnRelayToggled" />
        <TextBox x:Name="RelayBox2" Margin="0,2,0,0" />
        <TextBlock Style="{StaticResource HintText}" Text="{loc:Tr Settings_RelayHelp}" />

        <!-- Glossary & No-Translate -->
        <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Tr Settings_GroupGlossary}" />
        <TextBlock Style="{StaticResource HintText}" Text="{loc:Tr Settings_GlossaryHelp}" Margin="0,0,0,4" />
        <TextBox x:Name="GlossaryBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Height="84" FontFamily="Consolas" FontSize="12" />

        <!-- Applications -->
        <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Tr Settings_GroupApps}" />
        <TextBlock Style="{StaticResource HintText}" Text="{loc:Tr Settings_AppsHelp}" Margin="0,0,0,4" />
        <ItemsControl x:Name="ExcludedList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,2">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:Tr Common_Remove}" Padding="8,2" Tag="{Binding}" Click="OnRemoveExcluded" />
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel Margin="0,4,0,0">
          <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{loc:Tr Common_Add}" Padding="10,3" Margin="6,0,0,0" Click="OnAddExcluded" />
          <TextBox x:Name="NewExcludedBox" />
        </DockPanel>

        <!-- Fallback & Vision Snip shortcuts -->
        <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Tr Settings_GroupShortcuts}" />
        <CheckBox x:Name="SnipHotkeyEnabledBox" Content="{loc:Tr Settings_SnipEnable}" />
        <DockPanel Margin="0,2,0,6">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_SnipShortcut}" Width="120" />
          <TextBox x:Name="SnipHotkeyBox" Width="140" HorizontalAlignment="Left" />
        </DockPanel>
        <TextBlock x:Name="SnipHotkeyStatus" Style="{StaticResource HintText}" Text="{loc:Tr Settings_SnipHelp}" Margin="0,0,0,8" />

        <CheckBox x:Name="HotkeyEnabledBox" Content="{loc:Tr Settings_HotkeyEnable}" />
        <DockPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_TextShortcut}" Width="120" />
          <TextBox x:Name="HotkeyBox" Width="140" HorizontalAlignment="Left" />
        </DockPanel>
        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource HintText}" Text="{loc:Tr Settings_HotkeyHelp}" />

        <!-- Advanced -->
        <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Tr Settings_GroupAdvanced}" />
        <DockPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_SettleDelay}" Width="120" />
          <Slider x:Name="DelaySlider" Minimum="120" Maximum="800" TickFrequency="10" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center" ValueChanged="OnDelayChanged" />
          <TextBlock x:Name="DelayLabel" Margin="10,0,0,0" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Style="{StaticResource HintText}" Text="{loc:Tr Settings_SettleHelp}" />
        <CheckBox x:Name="UiaEventsBox" Content="{loc:Tr Settings_UiaEvents}" />
        <CheckBox x:Name="FileLoggingBox" Content="{loc:Tr Settings_FileLogging}" />
        <TextBlock Style="{StaticResource HintText}">
          <Run Text="{loc:Tr Settings_FilePath}" /><Run x:Name="SettingsPathRun" />
        </TextBlock>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
