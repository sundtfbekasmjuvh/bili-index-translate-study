<Window x:Class="BiliIndexTranslate.App.Vocabulary.VocabularyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BiliIndexTranslate.App.Localization"
        Title="{loc:Tr Vocab_Title}"
        Style="{StaticResource UiWindow}"
        Width="760" Height="520" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <Window.Resources>
    <Style TargetType="TextBox" BasedOn="{StaticResource UiTextBox}" />

    <!-- Rows: no system highlight colours (they ignore the app theme); the selection uses the accent brushes. -->
    <Style x:Key="VocabularyRow" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" Padding="8,6" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Ui.AccentText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Margin="14">
    <!-- Bottom: actions and status -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button x:Name="DeleteButton" Style="{StaticResource SecondaryButton}" Content="{loc:Tr Vocab_Delete}" Click="OnDelete" Margin="0,0,6,0" />
          <Button x:Name="ClearButton" Style="{StaticResource SecondaryButton}" Content="{loc:Tr Vocab_Clear}" Click="OnClear" Margin="0,0,6,0" />
          <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" Content="{loc:Tr Vocab_Export}" Click="OnExport" />
        </StackPanel>
        <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Ui.TextSecondary}" />
      </DockPanel>
      <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" MinHeight="16"
                 Foreground="{DynamicResource Ui.TextSecondary}" />
    </StackPanel>

    <!-- Top: search and read-only notice -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Left" Text="{loc:Tr Vocab_Search}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Ui.TextSecondary}" FontSize="12" />
      <TextBox x:Name="SearchBox" AutomationProperties.Name="{loc:Tr Vocab_Search}" TextChanged="OnSearchChanged" />
    </DockPanel>
    <TextBlock x:Name="ReadOnlyNotice" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap"
               Foreground="{DynamicResource Ui.Error}" Text="{loc:Tr Vocab_ReadOnlyNotice}" />
    <TextBlock x:Name="SetAsideNotice" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap"
               Foreground="{DynamicResource Ui.Error}" />

    <!-- List: a header row and the entries; the columns are the same fixed widths in both, the two text columns share the rest. -->
    <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" Background="{DynamicResource Ui.Panel}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="8,6,25,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="90" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{loc:Tr Vocab_ColText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Ui.TextSecondary}" />
          <TextBlock Grid.Column="1" Text="{loc:Tr Vocab_ColMeaning}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Ui.TextSecondary}" Margin="8,0,0,0" />
          <TextBlock Grid.Column="2" Text="{loc:Tr Vocab_ColKind}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Ui.TextSecondary}" Margin="8,0,0,0" />
          <TextBlock Grid.Column="3" Text="{loc:Tr Vocab_ColAdded}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Ui.TextSecondary}" Margin="8,0,0,0" />
        </Grid>
        <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource Ui.Border}" />
        <Grid>
          <ListBox x:Name="EntryList" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                   Foreground="{DynamicResource Ui.Text}" ItemContainerStyle="{StaticResource VocabularyRow}"
                   ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   KeyDown="OnListKeyDown" AutomationProperties.Name="{loc:Tr Vocab_Title}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                  <TextBlock Grid.Column="2" Text="{Binding KindLabel}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                  <TextBlock Grid.Column="3" Text="{Binding AddedLabel}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyText" Text="{loc:Tr Vocab_Empty}" TextWrapping="Wrap" TextAlignment="Center" Margin="24" Visibility="Collapsed"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Ui.TextSecondary}" IsHitTestVisible="False" />
        </Grid>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
