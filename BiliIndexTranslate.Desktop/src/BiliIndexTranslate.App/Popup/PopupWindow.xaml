<Window x:Class="BiliIndexTranslate.App.Popup.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bili Index Translate"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" IsTabStop="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Popup.FontFamily}"
        AutomationProperties.Name="Translation popup">

  <!-- Outer margin reserves room for the shadow; PopupPresenter subtracts it when placing the card. -->
  <Grid x:Name="Root" Margin="14">
    <Border x:Name="Card"
            Background="{DynamicResource Popup.Surface}"
            BorderBrush="{DynamicResource Popup.Border}"
            BorderThickness="1"
            CornerRadius="8"
            MinWidth="88">
      <Border.Effect>
        <DropShadowEffect x:Name="Shadow" BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.16" Color="Black" />
      </Border.Effect>

      <Grid x:Name="CardGrid" Margin="14,10,14,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />  <!-- status caption (loading / error title) -->
          <RowDefinition Height="*" />     <!-- translation -->
          <RowDefinition Height="Auto" />  <!-- original text -->
          <RowDefinition Height="Auto" />  <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Loading -->
        <StackPanel x:Name="LoadingPanel" Grid.Row="0" Orientation="Horizontal" Visibility="Collapsed" Margin="0,2,0,2">
          <TextBlock x:Name="LoadingDots" Text="···" Foreground="{DynamicResource Popup.TextFaint}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock x:Name="LoadingText" Text="Translating" Foreground="{DynamicResource Popup.TextSecondary}" FontSize="12.5" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Error -->
        <StackPanel x:Name="ErrorPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,2,0,4">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icon.FontFamily}" FontSize="12" Foreground="{DynamicResource Popup.Error}" VerticalAlignment="Center" Margin="0,1,6,0" />
            <TextBlock x:Name="ErrorTitle" Text="Translation failed" Foreground="{DynamicResource Popup.Error}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="ErrorMessage" Foreground="{DynamicResource Popup.Text}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="360" />
          <TextBlock x:Name="ErrorHint" Foreground="{DynamicResource Popup.TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" MaxWidth="360" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="RetryButton" Style="{StaticResource TextActionButton}" Content="Retry" Click="OnRetryClick" />
            <Button x:Name="OpenSettingsButton" Style="{StaticResource TextActionButton}" Content="Open settings" Click="OnSettingsClick" />
          </StackPanel>
        </StackPanel>

        <!-- Translation -->
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Style="{StaticResource ThinScrollViewer}" Visibility="Collapsed">
          <TextBlock x:Name="TranslationText"
                     Foreground="{DynamicResource Popup.Text}"
                     TextWrapping="Wrap"
                     LineStackingStrategy="BlockLineHeight"
                     AutomationProperties.Name="Translation"
                     AutomationProperties.LiveSetting="Polite" />
        </ScrollViewer>

        <!-- Original (expandable) -->
        <StackPanel x:Name="OriginalPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,8,0,0">
          <Rectangle Height="1" Fill="{DynamicResource Popup.Divider}" Margin="0,0,0,7" />
          <TextBlock x:Name="OriginalText"
                     Foreground="{DynamicResource Popup.TextSecondary}"
                     TextWrapping="Wrap"
                     LineStackingStrategy="BlockLineHeight"
                     MaxHeight="140"
                     TextTrimming="CharacterEllipsis"
                     AutomationProperties.Name="Original text" />
        </StackPanel>

        <!-- Footer: caption on the left, study card trigger + hover controls on the right. -->
        <Grid x:Name="Footer" Grid.Row="3" Margin="0,6,0,0" MinHeight="22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Caption" Grid.Column="0" Foreground="{DynamicResource Popup.TextFaint}" FontSize="11" VerticalAlignment="Center" FontFamily="{StaticResource Ui.FontFamily}" />
          <Button x:Name="StudyButton" Grid.Column="1" Style="{StaticResource TextActionButton}" Padding="7,2" Margin="6,0,2,0"
                  Visibility="Collapsed" VerticalAlignment="Center"
                  ToolTip="打开伴随语言学习卡片（词根助记·常见搭配·双语例句·发音）"
                  Click="OnStudyClick" AutomationProperties.Name="Open language study card">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE82D;" FontFamily="{StaticResource Icon.FontFamily}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
              <TextBlock Text="学习卡片" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel x:Name="Controls" Grid.Column="2" Orientation="Horizontal" Opacity="0" VerticalAlignment="Center" Margin="2,0,-4,0">
            <Button x:Name="OriginalButton" Style="{StaticResource IconButton}" Content="&#xE8D2;" ToolTip="Show original text" Click="OnOriginalClick" AutomationProperties.Name="Show original text" />
            <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy translation" Click="OnCopyClick" AutomationProperties.Name="Copy translation" />
            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" ToolTip="Keep this translation open (pinned window)" Click="OnPinClick" AutomationProperties.Name="Keep open" />
            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close (Esc)" Click="OnCloseClick" AutomationProperties.Name="Close" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
