<Window x:Class="BiliIndexTranslate.UiTestTarget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIT UI Test Target" Width="720" Height="360"
        WindowStartupLocation="Manual" Left="200" Top="300">
  <!-- Multi-line and read-only: the app skips single-line inputs by default, and a read-only box cannot be edited by accident. -->
  <TextBox x:Name="SourceText"
           AutomationProperties.AutomationId="SourceText"
           AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" IsReadOnlyCaretVisible="True"
           FontSize="18" Margin="16" VerticalScrollBarVisibility="Auto"
           Text="The quick brown fox jumps over the lazy dog while the sun sets behind the hills." />
</Window>
