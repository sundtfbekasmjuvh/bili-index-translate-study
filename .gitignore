# Allowlist: only the two projects and the top-level docs are tracked.
/*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE
!/.gitattributes
!/BiliIndexTranslate.Desktop/
!/bili-index-translate/
!/bili-study-sandbox/
!/tests/
!/.github/
!/package.json
!/package-lock.json

# Build output
bin/
obj/
publish/
publish-sc/
TestResults/
.vs/
*.user
*.suo

# Written by Chromium when the unpacked extension is loaded (e2e tests, chrome://extensions)
/bili-index-translate/_metadata/
