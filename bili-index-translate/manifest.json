{
  "manifest_version": 3,
  "name": "Bili Index Translate",
  "version": "1.4.0",
  "description": "Inline translation, Alt+A streaming bilingual page, Alt+S zero-OCR vision snip, instTrans glossary & Language Study Card.",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting", "declarativeNetRequest"],
  "host_permissions": [
    "<all_urls>",
    "https://index-translate.bilibili.com/*",
    "https://seep.eu.org/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bili_direct_headers",
        "enabled": true,
        "path": "dnr_rules.json"
      }
    ]
  },
  "commands": {
    "toggle-immersive": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Toggle streaming bilingual webpage translation"
    },
    "snip-image-translate": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Snip webpage/video region for zero-OCR image translation & Study Card"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Bili Index Translate — Settings"
  }
}
