{
  "manifest_version": 3,
  "name": "Bili Index Translate",
  "version": "1.5.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting", "declarativeNetRequest"],
  "host_permissions": [
    "<all_urls>",
    "https://index-translate.bilibili.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bili_direct_headers",
        "enabled": true,
        "path": "dnr_rules.json"
      }
    ]
  },
  "commands": {
    "toggle-immersive": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "__MSG_cmdImmersive__"
    },
    "snip-image-translate": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "__MSG_cmdSnip__"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["i18n.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "__MSG_actionTitle__"
  }
}
